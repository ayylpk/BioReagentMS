# LLM（agent 对话主模型，OpenAI 兼容口：DeepSeek / DashScope 中转均可）
LLM_API_KEY=
LLM_BASE_URL=
# 留空则用代码默认 api.deepseek.com/v1（见 src/config/env.ts）；换中转站时再填
LLM_MODEL=deepseek-chat

# Embedding（DashScope text-embedding-v4）
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBED_DIM=1024

# 联网搜索已移除（原 TAVILY_API_KEY）：本地未命中改为"缺口问答"——
#   AI 生成带免责的通用参考 → 落 MySQL 待办（deploy/sql/05）→ 前端「缺口知识」页人工确认

# MySQL（BioReagentMS 主库；工具侧只读，service 侧自有表需写权限）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_DB=bioreagentms
MYSQL_PASSWORD=

# Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=reagent_knowledge

# 解析层（qwen-vl-ocr 页面重解析，走 DASHSCOPE_API_KEY）
VL_MODEL=qwen-vl-ocr-latest
# 单次解析允许升 VL 的页数上限（默认 60，成本闸）。超上限的页不再静默丢弃，会记账进 diag/台账
# VL_PAGE_CAP=60

# Python 解释器（pytools/parse.py 由它 spawn）
# ⚠️ 留空时的候选顺序：Windows = py → python3 → python；POSIX = python3 → python
#    本机血泪：`python` 可能是 msys 的 3.12（pymupdf/markitdown 一个没装），
#    而依赖装在 3.14 里 → 不指定就会"py 解析失败 → 落回手写 → 大量格式直接隔离"。
#    显式指定后就只认它（不会静默换解释器，宁可报错也不静默降级）：
# PYTHON_BIN=C:\Users\you\AppData\Local\Programs\Python\Python314\python.exe

# 自有 HTTP 服务（人审队列/摄取触发；集成期接管 /search 代理）
SERVICE_PORT=8123

# 人审端点鉴权（/review/* 与 /reaction/*）：**与 Java 后端同一个 secret**
# ⚠️ 本机要用人审页就必须填它；不填时人审端点返回 503（关掉但绝不敞开 —— 人审能改知识库内容）
# 部署侧由 docker-compose 注入 JWT_SECRET_KEY: ${JWT_SECRET}（与 backend 同值）
JWT_SECRET_KEY=
