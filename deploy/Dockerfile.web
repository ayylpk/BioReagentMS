# 前端：构建出静态文件，nginx 一把抓（静态 + 反代，线上不再有 vite）
# 构建上下文 = 仓库根（COPY 出不了 context，nginx.conf 和源码必须同源；compose 已按此配）
# ⚠️ 依赖已切 pnpm（package-lock.json 已删），用 corepack 取 package.json 里钉的 pnpm 版本
# ⚠️ 注意：deploy/nginx.conf 目前缺失，用本文件前得先补（前端若走本机 build dist 上传，可无视本文件）
FROM node:22-alpine AS build
WORKDIR /src
RUN corepack enable
COPY frontend-ChemReagentMS/package.json frontend-ChemReagentMS/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend-ChemReagentMS/ .
RUN pnpm run build

FROM nginx:1.27-alpine
COPY --from=build /src/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
