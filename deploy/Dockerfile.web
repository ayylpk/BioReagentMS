# 前端：构建出静态文件，nginx 一把抓（静态 + 反代，线上不再有 vite）
# 构建上下文 = 仓库根（COPY 出不了 context，nginx.conf 和源码必须同源；compose 已按此配）
FROM node:22-alpine AS build
WORKDIR /src
COPY frontend-BioReagentMS/package.json frontend-BioReagentMS/package-lock.json ./
RUN npm ci
COPY frontend-BioReagentMS/ .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /src/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
