# 复制为仓库根 .env（compose 同目录），值抄本机 tsAgent/.env / application-local.yml，权限 600
DB_PASSWORD=<am-mysql 的 root 密码>
JWT_SECRET=<随机 32+ 字节，openssl rand -hex 32 现生成>
LLM_API_KEY=<本机 .env 现抄>
DASHSCOPE_API_KEY=<同上>
# 联网搜索（TAVILY_API_KEY）已移除：本地未命中改为缺口问答（AI 生成 → MySQL 待办 → 人工确认）
MYSQL_PASSWORD=<同 DB_PASSWORD>

# ── 解析/切块可调项（都已给默认值，只有要偏离默认时才写；本机 tsAgent/.env 同一套键）──
# 单次解析允许升 VL 的页数上限（默认 60；超上限的页不再静默丢，会记账进 diag/台账）
# VL_PAGE_CAP=60
# 切片目标区间与重叠（默认 800 / 250 / 10% 上限 150 字；改前实测基线是 p50=109、碎片率 59.5%）
# CHUNK_MAX=800
# CHUNK_MIN=250
# Python 解释器（镜像里是 python3，通常不用设；本机多解释器时用它钉住装了 pytools 依赖的那个）
# PYTHON_BIN=

# 人审端点（解析人审 /review、禁配审核 /reaction）由 tsAgent 自己校验 JWT + 查 role_permission。
# compose 已把 JWT_SECRET 注入给 bio-tsagent（JWT_SECRET_KEY），**与 backend 必须同值**；
# 少注入的后果是人审端点全部 503（安全侧失败，但功能等于关了）。
# 建表脚本：01_schema.sql（ingest_log）/ 02_reaction_rule.sql（禁配）/ 04_rag_review_queue.sql（人审队列）
